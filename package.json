{
    "name": "insightforge",
    "private": true,
    "workspaces": [
        "client"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
        "dev:client": "npm run dev --workspace=client",
        "dev:server": "tsx watch src/server.ts",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "concurrently": "^9.2.1"
    },
    "dependencies": {
        "react-icons": "^5.7.0"
    }
}